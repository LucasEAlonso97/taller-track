generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RepairStatus {
  RECEIVED
  IN_DIAGNOSIS
  WAITING_APPROVAL
  IN_REPAIR
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  UNREPAIRED
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum QuoteStatus {
  PENDING
  APPROVED
  REJECTED
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]
}

model Device {
  id               String   @id @default(uuid()) @db.Uuid
  type             String
  brand            String
  model            String
  serialNumber     String?
  accessories      String?
  initialCondition String?
  clientId         String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  repairOrders RepairOrder[]

  @@index([clientId])
}

model RepairOrder {
  id                      String       @id @default(uuid()) @db.Uuid
  code                    String       @unique
  trackingToken           String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportedIssue           String
  diagnosis               String?
  status                  RepairStatus @default(RECEIVED)
  estimatedCompletionDate DateTime?
  deliveredAt             DateTime?
  deviceId                String       @db.Uuid
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  device        Device                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  statusHistory RepairStatusHistory[]
  internalNotes RepairInternalNote[]
  photos        RepairPhoto[]
  quote         RepairQuote?

  @@index([deviceId])
  @@index([status])
}

model RepairStatusHistory {
  id            String       @id @default(uuid()) @db.Uuid
  status        RepairStatus
  repairOrderId String       @db.Uuid
  createdAt     DateTime     @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId])
  @@index([createdAt])
}

model RepairQuote {
  id            String      @id @default(uuid()) @db.Uuid
  amount        Int
  description   String?
  status        QuoteStatus @default(PENDING)
  respondedAt   DateTime?
  repairOrderId String      @unique @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
}

model RepairInternalNote {
  id            String   @id @default(uuid()) @db.Uuid
  content       String
  repairOrderId String   @db.Uuid
  createdAt     DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId])
  @@index([createdAt])
}

model RepairPhoto {
  id            String   @id @default(uuid()) @db.Uuid
  storageKey    String   @unique
  originalName  String
  mimeType      String
  size          Int
  repairOrderId String   @db.Uuid
  createdAt     DateTime @default(now())

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  @@index([repairOrderId])
  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TECHNICIAN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}
